{
  "manifest_version": 3,
  "name": "Mobi LinkedIn Scout",
  "version": "1.0.0",
  "description": "Owner-triggered capture of the LinkedIn feed posts you can see, sent to your Mobi LinkedIn Ops app. Read-only: it never scrolls, likes, connects, comments, or acts for you.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png",
    "256": "icons/icon-256.png",
    "512": "icons/icon-512.png",
    "1024": "icons/icon-1024.png"
  },
  "permissions": ["storage", "scripting", "activeTab"],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://mobi-linkedin-ops.vercel.app/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Mobi LinkedIn Scout",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_popup": "popup.html"
  }
}
