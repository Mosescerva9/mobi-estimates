# Mobi Estimates — Client Portal : environment contract
# Copy to .env.local and fill in real values. NEVER commit .env.local.
#
# Supabase ────────────────────────────────────────────────────────────────
# Project API URL and anon (publishable) key are safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Service-role key BYPASSES Row Level Security. SERVER-ONLY. Never prefix with
# NEXT_PUBLIC_. Used by Stripe webhooks / admin tasks (Milestone 2+).
# Copy it from: Supabase dashboard → Project Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Auth bootstrap ──────────────────────────────────────────────────────────
# Comma-separated emails that should be promoted to the 'admin' role on signup.
ADMIN_BOOTSTRAP_EMAILS=

# Canonical authenticated portal origin used for Stripe/email return links.
# Production defaults safely to https://portal.mobiestimates.com.
NEXT_PUBLIC_PORTAL_URL=https://portal.mobiestimates.com

# Stripe (Milestone 2) ────────────────────────────────────────────────────
# Server-only. Never prefix with NEXT_PUBLIC_.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# Stripe Price IDs — one recurring monthly Price per plan + one one-time Price.
# STRIPE_PRICE_STARTER=price_...                 # $995/mo recurring
# STRIPE_PRICE_GROWTH=price_...                  # $1,995/mo recurring
# STRIPE_PRICE_ESTIMATING_DEPARTMENT=price_...   # $2,995/mo recurring
# STRIPE_PRICE_PAY_PER_PROJECT=price_...         # $599 one-time
# NOTE: The 50%-off-first-month coupon is RETIRED. The regular monthly price
#       applies from month one — do not configure a first-month coupon.
# NOTE: Mobi Estimates offers NO free trial — never set trial_period_days/trial_end.
#       New companies get one qualifying estimate free (no card); see src/lib/intro-offer.ts.

# Resend (Milestone 6) ─────────────────────────────────────────────────────
# RESEND_API_KEY=
# EMAIL_FROM=

# Forwarded bid intake (inbound email) ────────────────────────────────────
# Contractors forward invitations to bid to estimates@mobiestimates.com.
#
# ⚠️  MX WARNING: receiving on the ROOT domain means the MX record for
#     mobiestimates.com points at Resend, so Resend receives ALL mail for the
#     domain. If any human mailbox on mobiestimates.com is hosted elsewhere
#     (Google Workspace, Microsoft 365, etc.), pointing MX at Resend BREAKS it.
#     A domain has one mail destination; this is not a split. If you need normal
#     mailboxes on mobiestimates.com, use a subdomain for intake instead — set
#     NEXT_PUBLIC_INTAKE_EMAIL_DOMAIN=bids.mobiestimates.com and add the MX
#     record on that subdomain only. Sending is unaffected either way (SPF/DKIM
#     are TXT records and don't conflict with MX).
#
# Receiving domain configured in Resend (Domains → add MX record).
# Public by nature (it is printed in the portal), so NEXT_PUBLIC_ is correct.
NEXT_PUBLIC_INTAKE_EMAIL_DOMAIN=mobiestimates.com
# Local part of the shared intake mailbox. The portal prints the per-company form
# {mailbox}+{intake_slug}@{domain}, which routes no matter who forwards; the plain
# {mailbox}@{domain} also works, routed by matching the sender to a member.
NEXT_PUBLIC_INTAKE_EMAIL_MAILBOX=estimates
# Signing secret for the Resend webhook that delivers `email.received` to
# /api/email/inbound. Svix/Standard-Webhooks format (whsec_...). SERVER-ONLY.
# Without it the intake endpoint fails closed with 503 and no mail is processed.
# RESEND_INBOUND_WEBHOOK_SECRET=
