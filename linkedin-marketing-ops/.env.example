# Optional: when set, drafts use OpenAI. Without it, local mock drafts are used.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Simple gate for the control panel (leave blank in local dev to skip).
OPS_PASSWORD=

# LinkedIn publishing (optional — stubbed until OAuth is wired).
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=

# Public base URL for the app
NEXT_PUBLIC_APP_NAME=Mobi LinkedIn Ops
